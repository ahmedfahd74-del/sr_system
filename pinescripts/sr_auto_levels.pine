//@version=6
indicator("SR Auto Levels", "SR Auto", overlay=true, max_lines_count=30, max_labels_count=30, max_bars_back=5000)

// ============================================================
// SR AUTO LEVELS v3 - Multi-Timeframe Price-Visit Heatmap
// ============================================================
// Same logic as drawing levels by hand:
//   "Draw a line where price has visited the most."
//
// Algorithm (per timeframe layer):
//   1. Get OHLC data from the target timeframe.
//   2. Divide the price range into buckets (width = zone_mult x ATR).
//   3. Count how many bars touched each bucket.
//   4. Keep buckets with >= min_visits.
//   5. Merge adjacent hot buckets into clean zones.
//   6. Tag each zone with which TF it came from.
//
// MTF: runs on Current TF + up to 3 HTFs you configure.
//      Zones found on multiple TFs appear THICKER + YELLOW tint.
//
// Add once -> works on every symbol automatically.
// ============================================================

// ============================================================
// INPUTS
// ============================================================
g_det = "Detection"
i_lookback   = input.int(300,  "Lookback bars (current TF)",   minval=50,  maxval=5000,          group=g_det, tooltip="Bars to scan on the current chart timeframe. 300 ~ 1 year on daily.")
i_zoneMult   = input.float(1.0,"Zone width (x ATR14)",          minval=0.2, maxval=5.0, step=0.1, group=g_det, tooltip="Bucket width as a multiple of ATR14. 1.0 = one full ATR per zone. Increase to get fewer, wider levels. Decrease for finer levels.")
i_minVisits  = input.int(3,    "Min bar-visits per level",      minval=1,   maxval=50,            group=g_det, tooltip="A zone only becomes a level when this many bars touched it. Higher = fewer but more significant levels.")
i_topN       = input.int(8,    "Max levels to draw (top N)",    minval=1,   maxval=20,            group=g_det, tooltip="Draw only the N most-visited zones across all active timeframes.")

g_mtf = "Multi-Timeframe"
i_mtf_curr   = input.bool(true,  "Current timeframe",         group=g_mtf)
i_mtf1_on    = input.bool(true,  "HTF 1 (e.g. Daily)",        group=g_mtf)
i_mtf1       = input.timeframe("D",   "HTF 1 timeframe",      group=g_mtf)
i_mtf2_on    = input.bool(true,  "HTF 2 (e.g. Weekly)",       group=g_mtf)
i_mtf2       = input.timeframe("W",   "HTF 2 timeframe",      group=g_mtf)
i_mtf3_on    = input.bool(false, "HTF 3 (optional)",          group=g_mtf)
i_mtf3       = input.timeframe("M",   "HTF 3 timeframe",      group=g_mtf)
i_htfBars    = input.int(200,  "HTF lookback bars",           minval=20, maxval=2000, group=g_mtf, tooltip="Bars to scan on each HTF. 200 bars on Weekly = ~4 years.")

g_line = "Line Appearance"
i_extMode  = input.string("Both",   "Line extend",   options=["None","Left only","Right only","Both"], group=g_line, tooltip="Both = full horizontal across chart, same as hand-drawn lines.")
i_lineStyl = input.string("Dashed", "Line style",    options=["Solid","Dashed","Dotted"],               group=g_line)
i_lwBase   = input.int(1, "Base line width",          minval=1, maxval=4, group=g_line)
i_lwMax    = input.int(3, "Max  line width",           minval=1, maxval=4, group=g_line, tooltip="Most-visited levels get this width. Width scales with visit count.")
i_lbOffset = input.int(6, "Label offset (bars right)", minval=1, maxval=50, group=g_line)

g_style = "Colors"
i_cSupp  = input.color(color.new(#00C853, 0), "Support color",              group=g_style)
i_cRes   = input.color(color.new(#FF1744, 0), "Resistance color",           group=g_style)
i_cMTF   = input.color(color.new(#FFD600, 0), "MTF confluence color",       group=g_style, tooltip="Zones confirmed on 2+ timeframes use this color.")
i_showLbls = input.bool(true,  "Show price + visit-count labels", group=g_style)
i_showTbl  = input.bool(true,  "Show status table (top right)",   group=g_style)

// ============================================================
// TRANSLATE STYLE INPUTS TO PINE CONSTANTS
// ============================================================
extMode  = i_extMode  == "None"       ? extend.none  : i_extMode  == "Left only"  ? extend.left  : i_extMode  == "Right only" ? extend.right : extend.both
lineStyl = i_lineStyl == "Dashed"     ? line.style_dashed : i_lineStyl == "Dotted" ? line.style_dotted : line.style_solid

// ============================================================
// HTF DATA - fetch OHLC arrays from higher timeframes
// ============================================================
// We request the raw series values (not aggregated) so we can
// replicate the heatmap on HTF bars.

[htf1_h, htf1_l] = request.security(syminfo.tickerid, i_mtf1,
     [high, low], lookahead=barmerge.lookahead_off)
[htf2_h, htf2_l] = request.security(syminfo.tickerid, i_mtf2,
     [high, low], lookahead=barmerge.lookahead_off)
[htf3_h, htf3_l] = request.security(syminfo.tickerid, i_mtf3,
     [high, low], lookahead=barmerge.lookahead_off)

htf1_atr = request.security(syminfo.tickerid, i_mtf1, ta.atr(14), lookahead=barmerge.lookahead_off)
htf2_atr = request.security(syminfo.tickerid, i_mtf2, ta.atr(14), lookahead=barmerge.lookahead_off)
htf3_atr = request.security(syminfo.tickerid, i_mtf3, ta.atr(14), lookahead=barmerge.lookahead_off)

// ============================================================
// DRAWING STATE
// ============================================================
var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var table tbl = table.new(position.top_right, 1, 6,
     frame_color=color.new(color.gray,60), frame_width=1,
     border_color=color.new(color.gray,70), border_width=1)

// ============================================================
// HEATMAP FUNCTION
// Returns arrays: [prices, touchCounts]
// highArr/lowArr are series passed at offset 0..barsBack-1
// ============================================================
f_heatmap(float refATR, float zoneMult, int barsBack, int minVisits,
     float[] highArr, float[] lowArr) =>
    float zoneW = na(refATR) or refATR <= 0.0 ? close * 0.005 : refATR * zoneMult

    // Find range
    float rHigh = highArr.get(0)
    float rLow  = lowArr.get(0)
    int   n     = highArr.size()
    for i = 1 to n - 1
        float h = highArr.get(i)
        float l = lowArr.get(i)
        if not na(h) and h > rHigh
            rHigh := h
        if not na(l) and l < rLow
            rLow := l

    float totalRng = rHigh - rLow
    if totalRng <= 0.0
        totalRng := zoneW * 2.0
        rLow     := close - zoneW
        rHigh    := close + zoneW

    int   nb  = math.max(1, math.min(500, int(math.ceil(totalRng / zoneW))))
    float bw  = totalRng / float(nb)

    array<int> hits = array.new<int>(nb, 0)

    for i = 0 to n - 1
        float h = highArr.get(i)
        float l = lowArr.get(i)
        if na(h) or na(l)
            continue
        int bLo = math.max(0, math.min(nb-1, int(math.floor((l - rLow) / bw))))
        int bHi = math.max(0, math.min(nb-1, int(math.floor((h - rLow) / bw))))
        for b = bLo to bHi
            hits.set(b, hits.get(b) + 1)

    // Merge adjacent hot buckets
    array<float> prices  = array.new<float>()
    array<int>   touches = array.new<int>()
    bool  inZ   = false
    float zSum  = 0.0
    int   zCnt  = 0
    int   zBest = 0

    for b = 0 to nb - 1
        int h = hits.get(b)
        if h >= minVisits
            float mid = rLow + (float(b) + 0.5) * bw
            if not inZ
                inZ   := true
                zSum  := mid
                zCnt  := 1
                zBest := h
            else
                zSum  += mid
                zCnt  += 1
                zBest := math.max(zBest, h)
        else
            if inZ
                prices.push(zSum / float(zCnt))
                touches.push(zBest)
                inZ := false
    if inZ
        prices.push(zSum / float(zCnt))
        touches.push(zBest)

    [prices, touches]

// ============================================================
// MAIN LOGIC - last bar only
// ============================================================
if barstate.islast
    for ln in drawnLines
        line.delete(ln)
    drawnLines.clear()
    for lb in drawnLabels
        label.delete(lb)
    drawnLabels.clear()

    float atr14 = ta.atr(14)

    // --- Collect current-TF data into arrays ---
    int bk = math.min(i_lookback, bar_index)
    array<float> curr_h = array.new<float>(bk)
    array<float> curr_l = array.new<float>(bk)
    for i = 0 to bk - 1
        curr_h.set(i, high[i])
        curr_l.set(i, low[i])

    // --- Collect HTF data into arrays ---
    int htfBk = math.min(i_htfBars, bar_index)
    array<float> h1_h = array.new<float>(htfBk)
    array<float> h1_l = array.new<float>(htfBk)
    array<float> h2_h = array.new<float>(htfBk)
    array<float> h2_l = array.new<float>(htfBk)
    array<float> h3_h = array.new<float>(htfBk)
    array<float> h3_l = array.new<float>(htfBk)
    for i = 0 to htfBk - 1
        h1_h.set(i, htf1_h[i])
        h1_l.set(i, htf1_l[i])
        h2_h.set(i, htf2_h[i])
        h2_l.set(i, htf2_l[i])
        h3_h.set(i, htf3_h[i])
        h3_l.set(i, htf3_l[i])

    // --- Run heatmap on each active layer ---
    // We store: price, touchCount, tfCount (how many TFs agreed)
    array<float> allPrices   = array.new<float>()
    array<int>   allTouches  = array.new<int>()
    array<int>   allTFcount  = array.new<int>()

    float mergeThresh = na(atr14) or atr14 <= 0.0 ? close * 0.005 : atr14 * i_zoneMult

    // Inline merge — avoids function-inside-if restriction in Pine v6
    f_do_merge(float[] src_p, int[] src_t) =>
        int np = src_p.size()
        if np > 0
            for i = 0 to np - 1
                float p = src_p.get(i)
                int   t = src_t.get(i)
                bool  found = false
                int   sz = allPrices.size()
                if sz > 0
                    for j = 0 to sz - 1
                        if math.abs(p - allPrices.get(j)) <= mergeThresh
                            allTouches.set(j, allTouches.get(j) + t)
                            allTFcount.set(j, allTFcount.get(j) + 1)
                            found := true
                            break
                if not found
                    allPrices.push(p)
                    allTouches.push(t)
                    allTFcount.push(1)

    if i_mtf_curr
        [cp, ct] = f_heatmap(atr14, i_zoneMult, bk, i_minVisits, curr_h, curr_l)
        f_merge(cp, ct)

    if i_mtf1_on and not na(htf1_atr)
        [p1, t1] = f_heatmap(htf1_atr, i_zoneMult, htfBk, i_minVisits, h1_h, h1_l)
        f_merge(p1, t1)

    if i_mtf2_on and not na(htf2_atr)
        [p2, t2] = f_heatmap(htf2_atr, i_zoneMult, htfBk, i_minVisits, h2_h, h2_l)
        f_merge(p2, t2)

    if i_mtf3_on and not na(htf3_atr)
        [p3, t3] = f_heatmap(htf3_atr, i_zoneMult, htfBk, i_minVisits, h3_h, h3_l)
        f_merge(p3, t3)

    int numZones = allPrices.size()

    // --- Sort by touch count descending ---
    if numZones > 1
        for i = 0 to numZones - 2
            int mx = i
            for j = i + 1 to numZones - 1
                if allTouches.get(j) > allTouches.get(mx)
                    mx := j
            if mx != i
                float tp  = allPrices.get(i)
                int   tt  = allTouches.get(i)
                int   tfc = allTFcount.get(i)
                allPrices.set(i,  allPrices.get(mx))
                allTouches.set(i, allTouches.get(mx))
                allTFcount.set(i, allTFcount.get(mx))
                allPrices.set(mx,  tp)
                allTouches.set(mx, tt)
                allTFcount.set(mx, tfc)

    // --- Draw top N ---
    int   topN      = math.min(i_topN, numZones)
    int   maxT      = topN > 0 ? allTouches.get(0) : i_minVisits
    int   suppCount = 0
    int   resCount  = 0
    int   mtfCount  = 0

    if topN > 0
        for i = 0 to topN - 1
            float lp  = allPrices.get(i)
            int   lt  = allTouches.get(i)
            int   tfc = allTFcount.get(i)

            bool  isSupp = lp <= close
            bool  isMTF  = tfc >= 2    // confirmed on 2+ timeframes

            // Color: MTF zones get the confluence color, else support/resistance
            color col = isMTF ? i_cMTF : isSupp ? i_cSupp : i_cRes

            float ratio = maxT > 0 ? float(lt) / float(maxT) : 0.0
            int   lw    = i_lwBase + int(math.round(ratio * float(i_lwMax - i_lwBase)))
            lw := math.max(i_lwBase, math.min(i_lwMax, lw))
            // MTF zones get +1 width to stand out
            if isMTF
                lw := math.min(i_lwMax, lw + 1)

            line ln = line.new(
                 x1    = bar_index - math.min(i_lookback, bar_index),
                 y1    = lp,
                 x2    = bar_index + i_lbOffset,
                 y2    = lp,
                 xloc  = xloc.bar_index,
                 extend = extMode,
                 color  = col,
                 width  = lw,
                 style  = lineStyl)
            drawnLines.push(ln)

            if i_showLbls
                string tfTag = isMTF ? " MTF" + str.tostring(tfc) : ""
                string lbl   = str.tostring(lp, format.mintick) + " [" + str.tostring(lt) + "x]" + tfTag
                label lb = label.new(
                     x        = bar_index + i_lbOffset,
                     y        = lp,
                     text     = lbl,
                     xloc     = xloc.bar_index,
                     color    = color.new(col, 80),
                     textcolor = col,
                     style    = label.style_label_left,
                     size     = size.small)
                drawnLabels.push(lb)

            if isSupp
                suppCount := suppCount + 1
            else
                resCount  := resCount  + 1
            if isMTF
                mtfCount := mtfCount + 1

    // --- Status table ---
    if i_showTbl
        table.clear(tbl, 0, 0, 0, 5)
        string tfs = (i_mtf_curr ? timeframe.period + " " : "") + (i_mtf1_on ? i_mtf1 + " " : "") + (i_mtf2_on ? i_mtf2 + " " : "") + (i_mtf3_on ? i_mtf3 : "")
        table.cell(tbl, 0, 0, syminfo.ticker + " | TFs: " + tfs,
             text_color=color.white,  bgcolor=color.new(color.black,50), text_size=size.small)
        table.cell(tbl, 0, 1, "ATR zone: " + str.tostring(na(atr14) ? 0.0 : atr14 * i_zoneMult, format.mintick),
             text_color=color.silver, bgcolor=color.new(color.black,80), text_size=size.small)
        table.cell(tbl, 0, 2, "Zones found: " + str.tostring(numZones) + " | Min visits: " + str.tostring(i_minVisits),
             text_color=color.silver, bgcolor=color.new(color.black,80), text_size=size.small)
        table.cell(tbl, 0, 3, "Drawn: " + str.tostring(suppCount) + "S  " + str.tostring(resCount) + "R  " + str.tostring(mtfCount) + " MTF",
             text_color=color.silver, bgcolor=color.new(color.black,80), text_size=size.small)
        table.cell(tbl, 0, 4, "Extend: " + i_extMode + " | " + i_lineStyl,
             text_color=color.silver, bgcolor=color.new(color.black,80), text_size=size.small)
        table.cell(tbl, 0, 5, "Yellow = confirmed on 2+ timeframes",
             text_color=color.new(#FFD600,0), bgcolor=color.new(color.black,80), text_size=size.tiny)

// ============================================================
// ALERTS - nearest level approach/break
// ============================================================
atr14_al = ta.atr(14)
_ph = ta.pivothigh(high, 5, 5)
_pl = ta.pivotlow(low,   5, 5)

var array<float> _rH = array.new<float>()
var array<float> _rL = array.new<float>()

if not na(_ph)
    _rH.push(_ph)
    if _rH.size() > 20
        _rH.shift()
if not na(_pl)
    _rL.push(_pl)
    if _rL.size() > 20
        _rL.shift()

float _ns = na
float _nr = na
if _rL.size() > 0
    for i = 0 to _rL.size() - 1
        float p = _rL.get(i)
        if p < close and (na(_ns) or p > _ns)
            _ns := p
if _rH.size() > 0
    for i = 0 to _rH.size() - 1
        float p = _rH.get(i)
        if p > close and (na(_nr) or p < _nr)
            _nr := p

bool apSupp = not na(_ns) and not na(atr14_al) and (close - _ns) <= atr14_al * 0.5 and (close - _ns) > 0
bool apRes  = not na(_nr) and not na(atr14_al) and (_nr - close) <= atr14_al * 0.5 and (_nr - close) > 0
bool bkSupp = not na(_ns) and close < _ns and close[1] >= _ns
bool bkRes  = not na(_nr) and close > _nr and close[1] <= _nr

alertcondition(apSupp, "Approaching support",    "Price within 0.5 ATR of nearest support.")
alertcondition(apRes,  "Approaching resistance", "Price within 0.5 ATR of nearest resistance.")
alertcondition(bkSupp, "Broke support",          "Close broke below nearest support.")
alertcondition(bkRes,  "Broke resistance",       "Close broke above nearest resistance.")
