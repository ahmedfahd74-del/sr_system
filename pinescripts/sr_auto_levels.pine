//@version=6
indicator("SR Auto Levels", "SR Auto", overlay=true, max_lines_count=30, max_labels_count=30, max_bars_back=5000)

// ============================================================
// SR AUTO Levels - price-visit heatmap approach
// ============================================================
// Places a horizontal line through every price area where the
// chart has ACTUALLY VISITED the most - exactly the same logic
// used when drawing levels by hand.
//
// Algorithm
// ---------
// 1. Divide the lookback price range into equal-sized buckets.
//    Bucket width = zone_atr_mult x ATR14 (auto-scales per asset/TF).
// 2. For every bar in the lookback count how many bars had their
//    HIGH >= bucket_mid AND LOW <= bucket_mid  (= "touched this area").
// 3. Keep buckets touched >= min_touches times.
// 4. Merge adjacent hot buckets into a single zone (running avg).
// 5. Sort by touch count, draw the top N as horizontal lines.
//    Line extends both ways by default so it looks like a proper
//    S/R line drawn by hand.
//
// Works on every ticker without any per-chart tuning.
// Add ONCE - auto-adapts when you switch symbols.
// ============================================================

// --------------------------------------------------------------
// INPUTS
// --------------------------------------------------------------
g_det = "Detection"
i_lookback    = input.int(300,  "Lookback bars",               minval=50, maxval=5000,           group=g_det, tooltip="How many bars to scan back. 300 = ~1 year on daily.")
i_zoneMult    = input.float(1.0, "Zone width (x ATR14)",        minval=0.2, maxval=5.0, step=0.1, group=g_det, tooltip="Width of each price bucket as a multiple of ATR. Larger = coarser zones (fewer, wider levels). Smaller = finer zones (more, narrower levels). 1.0 works well for most assets.")
i_minTouches  = input.int(3,    "Min bar-visits per level",     minval=1, maxval=50,              group=g_det, tooltip="A level only appears if this many bars in the lookback touched its price zone. 3 = at least 3 separate visits required.")
i_topN        = input.int(8,    "Levels to display (top N)",    minval=1, maxval=20,              group=g_det, tooltip="After filtering, draw only the N most-visited zones.")

g_line = "Line Appearance"
i_extMode  = input.string("Both",   "Line extend",   options=["None","Left only","Right only","Both"], group=g_line, tooltip="Both = full horizontal across the chart (looks like manual hand-drawn lines). Right only = projects forward only.")
i_lineStyl = input.string("Dashed", "Line style",    options=["Solid","Dashed","Dotted"],               group=g_line)
i_lwBase   = input.int(1, "Base line width",   minval=1, maxval=4, group=g_line)
i_lwMax    = input.int(2, "Max  line width",   minval=1, maxval=4, group=g_line, tooltip="Most-visited level uses this width. Scales down linearly.")
i_lbOffset = input.int(8, "Label offset (bars right)", minval=1, maxval=50, group=g_line, tooltip="How far to the right of the last bar the price label is placed.")

g_style = "Colors"
i_cSupp = input.color(color.new(#00C853, 0), "Support  color", group=g_style)
i_cRes  = input.color(color.new(#FF1744, 0), "Resistance color", group=g_style)
i_showLbls = input.bool(true, "Show price labels", group=g_style)
i_showTbl  = input.bool(true, "Show status table", group=g_style)

// --------------------------------------------------------------
// TRANSLATE STYLE INPUTS TO PINE CONSTANTS
// --------------------------------------------------------------
extMode = i_extMode == "None" ? extend.none : i_extMode == "Left only" ? extend.left : i_extMode == "Right only" ? extend.right : extend.both
lineStyl = i_lineStyl == "Dashed" ? line.style_dashed : i_lineStyl == "Dotted" ? line.style_dotted : line.style_solid

// --------------------------------------------------------------
// DRAWING STATE
// --------------------------------------------------------------
var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var table tbl = table.new(position.top_right, 1, 5, frame_color=color.new(color.gray,60), frame_width=1, border_color=color.new(color.gray,70), border_width=1)

// --------------------------------------------------------------
// MAIN LOGIC - runs only on the last bar
// --------------------------------------------------------------
if barstate.islast

    // Clean up previous drawings
    for ln in drawnLines
        line.delete(ln)
    drawnLines.clear()
    for lb in drawnLabels
        label.delete(lb)
    drawnLabels.clear()

    // -- 1. Measure the lookback range and ATR ------------------
    int   barsBack  = math.min(i_lookback, bar_index)
    float atr14     = ta.atr(14)
    float zoneWidth = na(atr14) or atr14 <= 0.0 ? close * 0.005 : atr14 * i_zoneMult

    float rangeHigh = high
    float rangeLow  = low
    if barsBack > 0
        for i = 1 to barsBack - 1
            float h = high[i]
            float l = low[i]
            if not na(h) and h > rangeHigh
                rangeHigh := h
            if not na(l) and l < rangeLow
                rangeLow := l

    // Guard against degenerate ranges
    float totalRange = rangeHigh - rangeLow
    if totalRange <= 0.0
        totalRange := zoneWidth * 2.0
        rangeLow   := close - zoneWidth
        rangeHigh  := close + zoneWidth

    // -- 2. Build price buckets and count bar-visits ------------
    int numBuckets = math.max(1, int(math.ceil(totalRange / zoneWidth)))
    // Cap to avoid huge arrays on very fine zones
    numBuckets := math.min(numBuckets, 500)
    float effectiveBucketW = totalRange / float(numBuckets)

    array<int>   bucketHits  = array.new<int>(numBuckets, 0)
    array<float> bucketFirst = array.new<float>(numBuckets, float(bar_index))  // first-bar index of earliest hit

    if barsBack > 0
        for i = 0 to barsBack - 1
            float h = high[i]
            float l = low[i]
            if na(h) or na(l)
                continue
            // Find which buckets this bar's range overlaps
            int bLo = int(math.floor((l - rangeLow) / effectiveBucketW))
            int bHi = int(math.floor((h - rangeLow) / effectiveBucketW))
            bLo := math.max(0, math.min(numBuckets - 1, bLo))
            bHi := math.max(0, math.min(numBuckets - 1, bHi))
            for b = bLo to bHi
                bucketHits.set(b, bucketHits.get(b) + 1)
                float curFirst = bucketFirst.get(b)
                float thisBar  = float(bar_index - i)
                if thisBar < curFirst
                    bucketFirst.set(b, thisBar)

    // -- 3. Collect hot buckets (>= min_touches) ---------------
    // Then merge adjacent hot buckets into single zones
    array<float> zonePrice  = array.new<float>()
    array<int>   zoneTouches = array.new<int>()
    array<int>   zoneFirstBar = array.new<int>()

    bool inZone    = false
    float zSum     = 0.0
    int   zCount   = 0
    int   zTouches = 0
    int   zFirst   = bar_index

    for b = 0 to numBuckets - 1
        int hits = bucketHits.get(b)
        if hits >= i_minTouches
            float bucketMid = rangeLow + (float(b) + 0.5) * effectiveBucketW
            int   fb        = int(bucketFirst.get(b))
            if not inZone
                inZone    := true
                zSum      := bucketMid
                zCount    := 1
                zTouches  := hits
                zFirst    := fb
            else
                zSum     += bucketMid
                zCount   += 1
                zTouches := math.max(zTouches, hits)
                if fb < zFirst
                    zFirst := fb
        else
            if inZone
                zonePrice.push(zSum / float(zCount))
                zoneTouches.push(zTouches)
                zoneFirstBar.push(zFirst)
                inZone := false
    // flush last zone
    if inZone
        zonePrice.push(zSum / float(zCount))
        zoneTouches.push(zTouches)
        zoneFirstBar.push(zFirst)

    int numZones = zonePrice.size()

    // -- 4. Sort by touch count descending (selection sort) ----
    if numZones > 1
        for i = 0 to numZones - 2
            int maxIdx = i
            for j = i + 1 to numZones - 1
                if zoneTouches.get(j) > zoneTouches.get(maxIdx)
                    maxIdx := j
            if maxIdx != i
                float tp = zonePrice.get(i)
                int   tt = zoneTouches.get(i)
                int   tf = zoneFirstBar.get(i)
                zonePrice.set(i,    zonePrice.get(maxIdx))
                zoneTouches.set(i,  zoneTouches.get(maxIdx))
                zoneFirstBar.set(i, zoneFirstBar.get(maxIdx))
                zonePrice.set(maxIdx,    tp)
                zoneTouches.set(maxIdx,  tt)
                zoneFirstBar.set(maxIdx, tf)

    // -- 5. Draw top N -----------------------------------------
    int   drawn    = 0
    int   maxTouches = numZones > 0 ? zoneTouches.get(0) : i_minTouches
    int   suppCount = 0
    int   resCount  = 0
    int   topN      = math.min(i_topN, numZones)

    if topN > 0
        for i = 0 to topN - 1
            float lp  = zonePrice.get(i)
            int   lt  = zoneTouches.get(i)
            int   lfb = zoneFirstBar.get(i)

            bool  isSupp  = lp <= close
            color col     = isSupp ? i_cSupp : i_cRes

            // Width: scales from base to max based on relative touch count
            float ratio = maxTouches > 0 ? float(lt) / float(maxTouches) : 0.0
            int   lw    = i_lwBase + int(math.round(ratio * float(i_lwMax - i_lwBase)))
            lw := math.max(i_lwBase, math.min(i_lwMax, lw))

            // x1 = where this level was first seen, x2 = beyond current bar
            int x1 = math.max(lfb, bar_index - barsBack)
            int x2 = bar_index + i_lbOffset

            line ln = line.new(x1=x1, y1=lp, x2=x2, y2=lp,
                 xloc=xloc.bar_index,
                 extend=extMode,
                 color=col,
                 width=lw,
                 style=lineStyl)
            drawnLines.push(ln)

            if i_showLbls
                string lbl = str.tostring(lp, format.mintick) + " [" + str.tostring(lt) + "x]"
                label lb = label.new(x=bar_index + i_lbOffset, y=lp,
                     text=lbl,
                     xloc=xloc.bar_index,
                     color=color.new(col, 80),
                     textcolor=col,
                     style=label.style_label_left,
                     size=size.small)
                drawnLabels.push(lb)

            if isSupp
                suppCount := suppCount + 1
            else
                resCount  := resCount  + 1
            drawn := drawn + 1

    // -- 6. Status table ----------------------------------------
    if i_showTbl
        table.clear(tbl, 0, 0, 0, 4)
        table.cell(tbl, 0, 0, syminfo.ticker + " " + timeframe.period,
             text_color=color.white, bgcolor=color.new(color.black, 50), text_size=size.small)
        table.cell(tbl, 0, 1, "ATR zone: " + str.tostring(zoneWidth, format.mintick),
             text_color=color.silver, bgcolor=color.new(color.black, 80), text_size=size.small)
        table.cell(tbl, 0, 2, "Hot zones found: " + str.tostring(numZones),
             text_color=color.silver, bgcolor=color.new(color.black, 80), text_size=size.small)
        table.cell(tbl, 0, 3, "Min " + str.tostring(i_minTouches) + " visits | Drawn: " + str.tostring(suppCount) + "S " + str.tostring(resCount) + "R",
             text_color=color.silver, bgcolor=color.new(color.black, 80), text_size=size.small)
        table.cell(tbl, 0, 4, "Extend: " + i_extMode + " | Style: " + i_lineStyl,
             text_color=color.silver, bgcolor=color.new(color.black, 80), text_size=size.small)

// --------------------------------------------------------------
// ALERTS
// --------------------------------------------------------------
atr14_alert = ta.atr(14)

var float nearestSupp = na
var float nearestRes  = na

// Re-find nearest levels for alert logic using pivot approach
_ph = ta.pivothigh(high, 5, 5)
_pl = ta.pivotlow(low, 5, 5)

var array<float> recentHighs = array.new<float>()
var array<float> recentLows  = array.new<float>()

if not na(_ph)
    recentHighs.push(_ph)
    if recentHighs.size() > 20
        recentHighs.shift()
if not na(_pl)
    recentLows.push(_pl)
    if recentLows.size() > 20
        recentLows.shift()

float _bestSupp = na
float _bestRes  = na
if recentLows.size() > 0
    for i = 0 to recentLows.size() - 1
        float p = recentLows.get(i)
        if p < close and (na(_bestSupp) or p > _bestSupp)
            _bestSupp := p
if recentHighs.size() > 0
    for i = 0 to recentHighs.size() - 1
        float p = recentHighs.get(i)
        if p > close and (na(_bestRes) or p < _bestRes)
            _bestRes := p

nearestSupp := _bestSupp
nearestRes  := _bestRes

bool approachSupp = not na(nearestSupp) and not na(atr14_alert) and (close - nearestSupp) <= atr14_alert * 0.5 and (close - nearestSupp) > 0
bool approachRes  = not na(nearestRes)  and not na(atr14_alert) and (nearestRes - close)  <= atr14_alert * 0.5 and (nearestRes - close)  > 0
bool breakSupp    = not na(nearestSupp) and close < nearestSupp and close[1] >= nearestSupp
bool breakRes     = not na(nearestRes)  and close > nearestRes  and close[1] <= nearestRes

alertcondition(approachSupp, "Approaching support",    "Price is within 0.5 ATR of nearest support.")
alertcondition(approachRes,  "Approaching resistance", "Price is within 0.5 ATR of nearest resistance.")
alertcondition(breakSupp,    "Broke support",          "Close just broke below nearest support.")
alertcondition(breakRes,     "Broke resistance",       "Close just broke above nearest resistance.")
