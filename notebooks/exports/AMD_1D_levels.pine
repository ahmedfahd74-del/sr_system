i_r10c = input.float(0.0, "R10 conf",  group=g_res, inline="r10")

// ----- Confluence (multi-timeframe agreement) -----
g_conf = "Confluence Levels"
i_c1p = input.float(430.9579, "C1 price", group=g_conf, inline="c1")
i_c1c = input.float(265.0, "C1 conf",  group=g_conf, inline="c1")
i_c1s = input.bool(true, "C1 is support", group=g_conf, inline="c1")
